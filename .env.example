# Скопируйте в .env и заполните. Файл .env не коммитится.
# Секреты генерируйте так:  openssl rand -hex 24

# ---------- Обязательные ----------
# Домен сайта (A-запись должна указывать на PUBLIC_IP)
DOMAIN=cs.example.com
# Публичный IPv4 VPS — нужен WebRTC (ICE) и TURN
PUBLIC_IP=203.0.113.10
# Почта для Let's Encrypt
ACME_EMAIL=admin@example.com
# Пароль RCON игрового сервера
RCON_PASSWORD=change-me
# Общий секрет coturn для временных TURN-учёток (TURN REST API)
TURN_SECRET=change-me-to-a-long-random-string

# ---------- Игровой сервер (yohimik/cs-web-server) ----------
# После первого деплоя scripts/pin-images.sh заменит тег на image@sha256:...
CS_SERVER_IMAGE=yohimik/cs-web-server:latest
SERVER_NAME=CS 1.6 Web
# UDP-порт игры/WebRTC (upstream: переменная PORT)
GAME_PORT=27018
START_MAP=de_dust2
MAX_PLAYERS=16
# Путь WebSocket-сигналинга внутри cs-server (HTTP :27016). [НЕ СВЕРЕНО] — см. KNOWN_ISSUES.md
CS_SIGNAL_PATH=/websocket
# Админ-панель upstream. Пусто = выключена. Наружу не публикуется.
ADMIN_PANEL_USER=
ADMIN_PANEL_PASSWORD=

# ---------- TURN (coturn) ----------
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Срок жизни выдаваемых TURN-учёток, секунд. Браузер не обновляет учётки в течение
# соединения, а coturn проверяет срок при каждом продлении allocation, поэтому TTL должен
# быть больше самой длинной игровой сессии через TURN (по умолчанию 24 часа).
TURN_TTL=86400

# ---------- Образы (закрепляются digest'ом скриптом scripts/pin-images.sh) ----------
CADDY_IMAGE=caddy:2.11-alpine
COTURN_IMAGE=coturn/coturn:4.6.3-alpine
NODE_IMAGE=node:22-alpine

# ---------- Необязательные ----------
# UDP-порт для запросов статуса (A2S / Xash3D info), если отличается от GAME_PORT
GAME_QUERY_PORT=
# Логин Steam для scripts/install-server-files.sh (по умолчанию anonymous)
STEAM_USER=
# Сайт на GitHub Pages, который ходит к этому серверу (CORS), например https://label777.github.io
ALLOWED_ORIGINS=
