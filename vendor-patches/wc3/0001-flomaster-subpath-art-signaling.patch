diff --git a/html/web-src/src/lib/version.ts b/html/web-src/src/lib/version.ts
index 9876a74c..39cd507c 100644
--- a/html/web-src/src/lib/version.ts
+++ b/html/web-src/src/lib/version.ts
@@ -21,6 +21,14 @@ export const BUILD_ID = String(Date.now());
  *  live at the top level of webapp/ regardless of which route is
  *  referencing them. */
 export function versionedAsset(path: string): string {
-  const cleaned = path.startsWith('/') ? path : '/' + path;
-  return `${cleaned}?v=${encodeURIComponent(BUILD_ID)}`;
+  const cleaned = path.replace(/^\/+/, '');
+  return `${siteRoot()}${cleaned}?v=${encodeURIComponent(BUILD_ID)}`;
+}
+
+/** Flomaster: корень сборки — absolute base из astro.config (WARSMASH_BASE),
+ *  а без него, как в upstream, корень домена. */
+function siteRoot(): string {
+  const base = import.meta.env.BASE_URL || '/';
+  if (!base.startsWith('/')) return '/';
+  return base.endsWith('/') ? base : base + '/';
 }
