@@ -0,0 +1,39 @@
+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.players;
+
+import com.etheller.interpreter.ast.scope.GlobalScope;
+import com.etheller.interpreter.ast.scope.trigger.Trigger;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3;
+
+/**
+ * Flomaster: подписка TriggerRegisterPlayerChatEvent. Как в Warcraft III: при exactMatchOnly сообщение
+ * должно совпасть со строкой целиком, иначе — содержать её (без учёта регистра); пустая строка
+ * означает «любое сообщение».
+ */
+public class FlomasterChatEvent extends CPlayerEvent {
+	private final String matchString;
+	private final boolean exactMatchOnly;
+
+	public FlomasterChatEvent(final GlobalScope globalScope, final CPlayerJass player, final Trigger trigger,
+			final String matchString, final boolean exactMatchOnly) {
+		super(globalScope, player, trigger, JassGameEventsWar3.EVENT_PLAYER_CHAT, null);
+		this.matchString = matchString == null ? "" : matchString;
+		this.exactMatchOnly = exactMatchOnly;
+	}
+
+	public String getMatchString() {
+		return this.matchString;
+	}
+
+	public boolean matches(final String message) {
+		if (message == null) {
+			return false;
+		}
+		if (this.matchString.isEmpty()) {
+			return true;
+		}
+		if (this.exactMatchOnly) {
+			return message.equalsIgnoreCase(this.matchString);
+		}
+		return message.toLowerCase().contains(this.matchString.toLowerCase());
+	}
+}
diff --git a/core/src/com/etheller/warsmash/viewer5/handlers/w3x/ui/FlomasterChatCodec.java b/core/src/com/etheller/warsmash/viewer5/handlers/w3x/ui/FlomasterChatCodec.java
new file mode 100644
index 00000000..81ddbcd5
--- /dev/null
+++ b/core/src/com/etheller/warsmash/viewer5/handlers/w3x/ui/FlomasterChatCodec.java
@@ -0,0 +1,61 @@
+package com.etheller.warsmash.viewer5.handlers.w3x.ui;
+
+/**
+ * Flomaster: сообщение чата как последовательность GUI-событий (int), чтобы не менять сетевой протокол
+ * Warsmash. Код события: MARKER | (тип << 16) | значение. Тип 0 — начало, 1 — символ (UTF-16), 2 — конец.
+ * Значения MARKER не пересекаются с id событий JassGameEventsWar3 (они меньше 1000).
+ */
+public final class FlomasterChatCodec {
+	public static final int MAX_LENGTH = 127;
+	private static final int MARKER = 0x7A000000;
+	private static final int MASK = 0xFF000000;
+	private static final int BEGIN = 0;
+	private static final int CHAR = 1;
+	private static final int END = 2;
+
+	private FlomasterChatCodec() {
+	}
+
+	public static int[] encode(final String text) {
+		final int[] out = new int[text.length() + 2];
+		out[0] = MARKER | (BEGIN << 16);
+		for (int i = 0; i < text.length(); i++) {
+			out[i + 1] = MARKER | (CHAR << 16) | (text.charAt(i) & 0xFFFF);
+		}
+		out[out.length - 1] = MARKER | (END << 16);
+		return out;
+	}
+
+	public static boolean isChatEvent(final int eventId) {
+		return (eventId & MASK) == MARKER;
+	}
+
+	/** Сборщик для одного игрока: возвращает готовое сообщение на событии «конец», иначе null. */
+	public static final class Decoder {
+		private final StringBuilder buffer = new StringBuilder();
+		private boolean active;
+
+		public String accept(final int eventId) {
+			final int type = (eventId >> 16) & 0xFF;
+			switch (type) {
+			case BEGIN:
+				this.buffer.setLength(0);
+				this.active = true;
+				return null;
+			case CHAR:
+				if (this.active && (this.buffer.length() < MAX_LENGTH)) {
+					this.buffer.append((char) (eventId & 0xFFFF));
+				}
+				return null;
+			case END:
+				if (!this.active) {
+					return null;
+				}
+				this.active = false;
+				return this.buffer.toString();
+			default:
+				return null;
+			}
+		}
+	}
+}
