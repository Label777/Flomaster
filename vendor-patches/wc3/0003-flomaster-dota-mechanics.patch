+
+/**
+ * Flomaster: способность Channel (ANcl) вместо тестовой заглушки upstream.
+ *
+ * Channel — «пустая» способность, на которой карты строят свои заклинания: сама она ничего не делает,
+ * а триггеры карты реагируют на события заклинания (EVENT_*_SPELL_CHANNEL/CAST/EFFECT/FINISH/ENDCAST,
+ * их запускают CBehavior*SpellBase). Поля редактора:
+ * <ul>
+ * <li>DataA — Follow Through Time: сколько секунд юнит продолжает «каналить» после эффекта;</li>
+ * <li>DataB — Target Type: 0 — без цели, 1 — юнит, 2 — точка, 3 — юнит или точка;</li>
+ * <li>DataC — Options (флаги): 1 — значок виден, 2 — область, 4 — физическое, 8 — универсальное, 16 — уникальное;</li>
+ * <li>DataD — Art Duration (не используется: эффекты рисует карта);</li>
+ * <li>DataE — Disable Other Abilities (пока не поддерживается);</li>
+ * <li>DataF — Base Order ID: строка приказа, под которой способность принимает приказы.</li>
+ * </ul>
+ */
+public class CAbilityChannel extends CAbilitySpellBase {
+	public static final int TARGET_NONE = 0;
+	public static final int TARGET_UNIT = 1;
+	public static final int TARGET_POINT = 2;
+	public static final int TARGET_UNIT_OR_POINT = 3;
+
+	private static final int OPTION_VISIBLE = 1;
+	private static final int OPTION_AREA = 2;
+	private static final int OPTION_PHYSICAL = 4;
+	private static final int OPTION_UNIVERSAL = 8;
+
+	private float followThroughTime;
+	private int targetType = TARGET_NONE;
+	private int options = OPTION_VISIBLE;
+	private int baseOrderId = OrderIds.channel;
+	private float areaOfEffect;
+	private int channelStartTick;
+
+	private CBehaviorNoTargetSpellBase noTargetBehavior;
+	private CBehaviorTargetSpellBase targetBehavior;
+
+	public CAbilityChannel(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.followThroughTime = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.targetType = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_B + level, 0);
+		this.options = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_C + level, 0);
+		this.areaOfEffect = worldEditorAbility.getFieldAsFloat(AbilityFields.AREA_OF_EFFECT + level, 0);
+		final String orderString = worldEditorAbility.getFieldAsString(AbilityFields.DATA_F + level, 0);
+		int orderId = 0;
+		if ((orderString != null) && !orderString.isEmpty() && !"_".equals(orderString)) {
+			orderId = OrderIdUtils.getOrderId(orderString.trim());
+		}
+		this.baseOrderId = orderId != 0 ? orderId : OrderIds.channel;
+		setIconShowing((this.options & OPTION_VISIBLE) != 0);
+	}
+
+	@Override
+	public void onAdd(final CSimulation game, final CUnit unit) {
+		this.noTargetBehavior = new CBehaviorNoTargetSpellBase(unit, this);
+		this.targetBehavior = new CBehaviorTargetSpellBase(unit, this);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return this.baseOrderId;
+	}
+
+	@Override
+	public float getUIAreaOfEffect() {
+		if (((this.options & OPTION_AREA) != 0) && (this.areaOfEffect > 0)) {
+			return this.areaOfEffect;
+		}
+		return Float.NaN;
+	}
+
+	@Override
+	public boolean isPhysical() {
+		return (this.options & OPTION_PHYSICAL) != 0;
+	}
+
+	@Override
+	public boolean isUniversal() {
+		return (this.options & OPTION_UNIVERSAL) != 0;
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		// Сам эффект — забота триггеров карты (они ловят EVENT_*_SPELL_EFFECT).
+		this.channelStartTick = simulation.getGameTurnTick();
+		return this.followThroughTime > 0;
+	}
+
+	@Override
+	public boolean doChannelTick(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final int ticks = simulation.getGameTurnTick() - this.channelStartTick;
+		return ticks < (int) (this.followThroughTime / WarsmashConstants.SIMULATION_STEP_TIME);
+	}
+
+	@Override
+	public CBehavior begin(final CSimulation game, final CUnit caster, final int orderId, final CWidget target) {
+		return this.targetBehavior.reset(game, target);
+	}
+
+	@Override
+	public CBehavior begin(final CSimulation game, final CUnit caster, final int orderId,
+			final AbilityPointTarget point) {
+		return this.targetBehavior.reset(game, point);
+	}
+
+	@Override
+	public CBehavior beginNoTarget(final CSimulation game, final CUnit caster, final int orderId) {
+		return this.noTargetBehavior.reset();
+	}
+
+	@Override
+	protected void innerCheckCanTarget(final CSimulation game, final CUnit unit, final int orderId,
+			final CWidget target, final AbilityTargetCheckReceiver<CWidget> receiver) {
+		if ((this.targetType != TARGET_UNIT) && (this.targetType != TARGET_UNIT_OR_POINT)) {
+			receiver.orderIdNotAccepted();
+			return;
+		}
+		if (target.canBeTargetedBy(game, unit, getTargetsAllowed(), receiver)) {
+			if (!unit.isMovementDisabled() || unit.canReach(target, getCastRange())) {
+				receiver.targetOk(target);
+			}
+			else {
+				receiver.targetCheckFailed(CommandStringErrorKeys.TARGET_IS_OUTSIDE_RANGE);
+			}
+		}
+	}
+
+	@Override
+	protected void innerCheckCanTarget(final CSimulation game, final CUnit unit, final int orderId,
+			final AbilityPointTarget target, final AbilityTargetCheckReceiver<AbilityPointTarget> receiver) {
+		if ((this.targetType != TARGET_POINT) && (this.targetType != TARGET_UNIT_OR_POINT)) {
+			receiver.orderIdNotAccepted();
+			return;
+		}
+		if (!unit.isMovementDisabled() || unit.canReach(target, getCastRange())) {
+			receiver.targetOk(target);
+		}
+		else {
+			receiver.targetCheckFailed(CommandStringErrorKeys.TARGET_IS_OUTSIDE_RANGE);
+		}
+	}
+
+	@Override
+	protected void innerCheckCanTargetNoTarget(final CSimulation game, final CUnit unit, final int orderId,
+			final AbilityTargetCheckReceiver<Void> receiver) {
+		if (this.targetType == TARGET_NONE) {
+			receiver.targetOk(null);
+		}
+		else {
+			receiver.orderIdNotAccepted();
+		}
+	}
+}
