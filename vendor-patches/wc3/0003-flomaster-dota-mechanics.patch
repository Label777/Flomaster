+package com.etheller.warsmash.parsers.jass;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import com.etheller.interpreter.ast.scope.trigger.Trigger;
+import com.etheller.interpreter.ast.util.JassProgram;
+import com.etheller.interpreter.ast.value.BooleanJassValue;
+import com.etheller.interpreter.ast.value.HandleJassType;
+import com.etheller.interpreter.ast.value.HandleJassValue;
+import com.etheller.interpreter.ast.value.IntegerJassValue;
+import com.etheller.interpreter.ast.value.JassValue;
+import com.etheller.interpreter.ast.value.JassValueVisitor;
+import com.etheller.interpreter.ast.value.RealJassValue;
+import com.etheller.interpreter.ast.value.StringJassValue;
+import com.etheller.interpreter.ast.value.visitor.BooleanJassValueVisitor;
+import com.etheller.interpreter.ast.value.visitor.IntegerJassValueVisitor;
+import com.etheller.interpreter.ast.value.visitor.ObjectJassValueVisitor;
+import com.etheller.interpreter.ast.value.visitor.RealJassValueVisitor;
+import com.etheller.interpreter.ast.value.visitor.StringJassValueVisitor;
+import com.etheller.warsmash.parsers.jass.scope.CommonTriggerExecutionScope;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.inventory.CAbilityInventory;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffTimedLife;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityPointTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CPlayer;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CPlayerJass;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.FlomasterChatEvent;
+
+/**
+ * Flomaster: нативки JASS, которых нет в Warsmash, а пользовательским картам (DotA Allstars и др.) они
+ * нужны. Регистрируются из {@code Jass2.CommonEnvironment} до разбора common.j; если upstream позже
+ * реализует ту же нативку, её реализация (зарегистрированная раньше) будет перезаписана этой —
+ * поэтому сюда попадает только то, чего в upstream нет.
+ */
+final class FlomasterNatives {
+	private FlomasterNatives() {
+	}
+
+	/** Игровой кэш (gamecache) в памяти: карта → категория → ключ → значение. На диск не сохраняется. */
+	static final class GameCache {
+		private final Map<String, Map<String, Object>> missions = new HashMap<>();
+
+		void put(final String mission, final String key, final Object value) {
+			this.missions.computeIfAbsent(mission, k -> new HashMap<>()).put(key, value);
+		}
+
+		Object get(final String mission, final String key) {
+			final Map<String, Object> keys = this.missions.get(mission);
+			return keys == null ? null : keys.get(key);
+		}
+
+		boolean has(final String mission, final String key, final Class<?> type) {
+			return type.isInstance(get(mission, key));
+		}
+
+		void flushKey(final String mission, final String key) {
+			final Map<String, Object> keys = this.missions.get(mission);
+			if (keys != null) {
+				keys.remove(key);
+			}
+		}
+
+		void flushMission(final String mission) {
+			this.missions.remove(mission);
+		}
+
+		void flushAll() {
+			this.missions.clear();
+		}
+	}
+
+	private static <T> T arg(final List<JassValue> arguments, final int index, final JassValueVisitor<T> visitor) {
+		final JassValue value = arguments.get(index);
+		return value == null ? null : value.visit(visitor);
+	}
+
+	private static String str(final List<JassValue> arguments, final int index) {
+		final String value = arg(arguments, index, StringJassValueVisitor.getInstance());
+		return value == null ? "" : value;
+	}
+
+	static void register(final JassProgram jassProgramVisitor, final CSimulation simulation,
+			final HandleJassType unitType, final HandleJassType eventType, final HandleJassType gamecacheType) {
+		// --- Продажа юнитов (таверны) ------------------------------------------------
+		jassProgramVisitor.getJassNativeManager().createNative("GetSoldUnit",
+				(arguments, globalScope, triggerScope) -> new HandleJassValue(unitType,
+						((CommonTriggerExecutionScope) triggerScope).getSoldUnit()));
+		jassProgramVisitor.getJassNativeManager().createNative("GetSellingUnit",
+				(arguments, globalScope, triggerScope) -> new HandleJassValue(unitType,
+						((CommonTriggerExecutionScope) triggerScope).getSellingUnit()));
+		jassProgramVisitor.getJassNativeManager().createNative("GetBuyingUnit",
+				(arguments, globalScope, triggerScope) -> new HandleJassValue(unitType,
+						((CommonTriggerExecutionScope) triggerScope).getBuyingUnit()));
+
+		// --- Чат ----------------------------------------------------------------------
+		jassProgramVisitor.getJassNativeManager().createNative("TriggerRegisterPlayerChatEvent",
+				(arguments, globalScope, triggerScope) -> {
+					final Trigger whichTrigger = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					final CPlayerJass whichPlayer = arg(arguments, 1, ObjectJassValueVisitor.getInstance());
+					if ((whichTrigger == null) || !(whichPlayer instanceof CPlayer)) {
+						return eventType.getNullValue();
+					}
+					final String chatMessageToDetect = str(arguments, 2);
+					final Boolean exactMatchOnly = arg(arguments, 3, BooleanJassValueVisitor.getInstance());
+					final FlomasterChatEvent event = new FlomasterChatEvent(globalScope, whichPlayer, whichTrigger,
+							chatMessageToDetect, Boolean.TRUE.equals(exactMatchOnly));
+					((CPlayer) whichPlayer).addEvent(event);
+					return new HandleJassValue(eventType, event);
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("GetEventPlayerChatString",
+				(arguments, globalScope, triggerScope) -> {
+					final String s = ((CommonTriggerExecutionScope) triggerScope).getChatString();
+					return StringJassValue.of(s == null ? "" : s);
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("GetEventPlayerChatStringMatched",
+				(arguments, globalScope, triggerScope) -> {
+					final String s = ((CommonTriggerExecutionScope) triggerScope).getChatStringMatched();
+					return StringJassValue.of(s == null ? "" : s);
+				});
+
+		// --- Герои ----------------------------------------------------------------------
+		jassProgramVisitor.getJassNativeManager().createNative("ReviveHero",
+				(arguments, globalScope, triggerScope) -> {
+					final CUnit hero = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (hero == null) {
+						return BooleanJassValue.FALSE;
+					}
+					final float x = arg(arguments, 1, RealJassValueVisitor.getInstance()).floatValue();
+					final float y = arg(arguments, 2, RealJassValueVisitor.getInstance()).floatValue();
+					final Boolean eyecandy = arg(arguments, 3, BooleanJassValueVisitor.getInstance());
+					return BooleanJassValue
+							.of(hero.flomasterReviveHero(simulation, x, y, Boolean.TRUE.equals(eyecandy)));
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("ReviveHeroLoc",
+				(arguments, globalScope, triggerScope) -> {
+					final CUnit hero = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					final AbilityPointTarget loc = arg(arguments, 1, ObjectJassValueVisitor.getInstance());
+					if ((hero == null) || (loc == null)) {
+						return BooleanJassValue.FALSE;
+					}
+					final Boolean eyecandy = arg(arguments, 2, BooleanJassValueVisitor.getInstance());
+					return BooleanJassValue
+							.of(hero.flomasterReviveHero(simulation, loc.x, loc.y, Boolean.TRUE.equals(eyecandy)));
+				});
+
+		// --- Юниты ------------------------------------------------------------------------
+		jassProgramVisitor.getJassNativeManager().createNative("UnitApplyTimedLife",
+				(arguments, globalScope, triggerScope) -> {
+					final CUnit whichUnit = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (whichUnit != null) {
+						final int buffId = arg(arguments, 1, IntegerJassValueVisitor.getInstance());
+						final float duration = arg(arguments, 2, RealJassValueVisitor.getInstance()).floatValue();
+						whichUnit.add(simulation, new CBuffTimedLife(simulation.getHandleIdAllocator().createId(),
+								new War3ID(buffId), duration, false));
+					}
+					return null;
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("UnitResetCooldown",
+				(arguments, globalScope, triggerScope) -> {
+					final CUnit whichUnit = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (whichUnit != null) {
+						whichUnit.flomasterResetCooldowns();
+					}
+					return null;
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("UnitInventorySize",
+				(arguments, globalScope, triggerScope) -> {
+					final CUnit whichUnit = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (whichUnit == null) {
+						return IntegerJassValue.ZERO;
+					}
+					final CAbilityInventory inventory = whichUnit.getInventoryData();
+					return IntegerJassValue.of(inventory == null ? 0 : inventory.getItemCapacity());
+				});
+
+		// --- Игровой кэш (gamecache) в памяти -------------------------------------------------
+		jassProgramVisitor.getJassNativeManager().createNative("InitGameCache",
+				(arguments, globalScope, triggerScope) -> new HandleJassValue(gamecacheType, new GameCache()));
+		jassProgramVisitor.getJassNativeManager().createNative("SaveGameCache",
+				(arguments, globalScope, triggerScope) -> BooleanJassValue.TRUE);
+		jassProgramVisitor.getJassNativeManager().createNative("ReloadGameCachesFromDisk",
+				(arguments, globalScope, triggerScope) -> BooleanJassValue.FALSE);
+		registerStore(jassProgramVisitor, "StoreInteger", IntegerJassValueVisitor.getInstance());
+		registerStore(jassProgramVisitor, "StoreReal", RealJassValueVisitor.getInstance());
+		registerStore(jassProgramVisitor, "StoreBoolean", BooleanJassValueVisitor.getInstance());
+		registerStore(jassProgramVisitor, "StoreString", StringJassValueVisitor.getInstance());
+		jassProgramVisitor.getJassNativeManager().createNative("GetStoredInteger",
+				(arguments, globalScope, triggerScope) -> {
+					final Object v = stored(arguments);
+					return IntegerJassValue.of(v instanceof Integer ? (Integer) v : 0);
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("GetStoredReal",
+				(arguments, globalScope, triggerScope) -> {
+					final Object v = stored(arguments);
+					return RealJassValue.of(v instanceof Double ? (Double) v : 0.0);
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("GetStoredBoolean",
+				(arguments, globalScope, triggerScope) -> BooleanJassValue.of(Boolean.TRUE.equals(stored(arguments))));
+		jassProgramVisitor.getJassNativeManager().createNative("GetStoredString",
+				(arguments, globalScope, triggerScope) -> {
+					final Object v = stored(arguments);
+					return StringJassValue.of(v instanceof String ? (String) v : "");
+				});
+		registerHave(jassProgramVisitor, "HaveStoredInteger", Integer.class);
+		registerHave(jassProgramVisitor, "HaveStoredReal", Double.class);
+		registerHave(jassProgramVisitor, "HaveStoredBoolean", Boolean.class);
+		registerHave(jassProgramVisitor, "HaveStoredString", String.class);
+		for (final String flush : new String[] { "FlushStoredInteger", "FlushStoredReal", "FlushStoredBoolean",
+				"FlushStoredString", "FlushStoredUnit" }) {
+			jassProgramVisitor.getJassNativeManager().createNative(flush, (arguments, globalScope, triggerScope) -> {
+				final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+				if (cache != null) {
+					cache.flushKey(str(arguments, 1), str(arguments, 2));
+				}
+				return null;
+			});
+		}
+		jassProgramVisitor.getJassNativeManager().createNative("FlushStoredMission",
+				(arguments, globalScope, triggerScope) -> {
+					final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (cache != null) {
+						cache.flushMission(str(arguments, 1));
+					}
+					return null;
+				});
+		jassProgramVisitor.getJassNativeManager().createNative("FlushGameCache",
+				(arguments, globalScope, triggerScope) -> {
+					final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+					if (cache != null) {
+						cache.flushAll();
+					}
+					return null;
+				});
+		// Синхронизация кэша между игроками: в lockstep все клиенты и так считают одно и то же.
+		for (final String sync : new String[] { "SyncStoredInteger", "SyncStoredReal", "SyncStoredBoolean",
+				"SyncStoredString", "SyncStoredUnit" }) {
+			jassProgramVisitor.getJassNativeManager().createNative(sync, (arguments, globalScope, triggerScope) -> null);
+		}
+	}
+
+	private static Object stored(final List<JassValue> arguments) {
+		final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+		return cache == null ? null : cache.get(str(arguments, 1), str(arguments, 2));
+	}
+
+	private static <T> void registerStore(final JassProgram jassProgramVisitor, final String name,
+			final JassValueVisitor<T> valueVisitor) {
+		jassProgramVisitor.getJassNativeManager().createNative(name, (arguments, globalScope, triggerScope) -> {
+			final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+			if (cache != null) {
+				final Object value = arg(arguments, 3, valueVisitor);
+				cache.put(str(arguments, 1), str(arguments, 2), value);
+			}
+			return null;
+		});
+	}
+
+	private static void registerHave(final JassProgram jassProgramVisitor, final String name, final Class<?> type) {
+		jassProgramVisitor.getJassNativeManager().createNative(name, (arguments, globalScope, triggerScope) -> {
+			final GameCache cache = arg(arguments, 0, ObjectJassValueVisitor.getInstance());
+			return BooleanJassValue.of((cache != null) && cache.has(str(arguments, 1), str(arguments, 2), type));
+		});
+	}
+}
