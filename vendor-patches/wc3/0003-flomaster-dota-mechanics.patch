+	// ---------------------------------------------------------------------
+	// Flomaster: возможности, которых не хватает картам вроде DotA Allstars
+	// ---------------------------------------------------------------------
+
+	/**
+	 * Нативка ReviveHero: воскрешает мёртвого героя в точке (x, y) с полными жизнями и маной, как это
+	 * делает алтарь, но без очереди и оплаты. Возвращает false, если юнит не мёртвый герой.
+	 */
+	public boolean flomasterReviveHero(final CSimulation game, final float x, final float y,
+			final boolean doEyecandy) {
+		if (!isDead() || !this.unitType.isHero()) {
+			return false;
+		}
+		final CAbilityHero heroData = getHeroData();
+		if (heroData != null) {
+			heroData.setReviving(false);
+			heroData.setAwaitingRevive(false);
+		}
+		game.getWorldCollision().removeUnit(this);
+		this.corpse = false;
+		this.boneCorpse = false;
+		this.deathTurnTick = 0;
+		this.explodesOnDeath = false;
+		this.explodesOnDeathBuffId = null;
+		setX(x);
+		setY(y);
+		game.getWorldCollision().addUnit(this);
+		setPoint(x, y, game.getWorldCollision(), game.getRegionManager());
+		setHidden(false);
+		setLife(game, getMaximumLife());
+		setMana(getMaximumMana());
+		setFoodUsed(this.unitType.getFoodUsed());
+		game.getPlayer(this.playerIndex).setUnitFoodMade(this, this.unitType.getFoodMade());
+		setPointAndCheckUnstuck(x, y, game);
+		game.unitRepositioned(this);
+		game.heroReviveEvent(this, this);
+		this.unitAnimationListener.playAnimation(true, PrimaryTag.STAND, SequenceUtils.EMPTY, 0.0f, true);
+		return true;
+	}
+
+	/** Нативка UnitResetCooldown: сбрасывает перезарядку всех способностей юнита. */
+	public void flomasterResetCooldowns() {
+		this.rawcodeToCooldownExpireTime.clear();
+		this.rawcodeToCooldownStartTime.clear();
+		fireCooldownsChangedEvent();
+	}
+
+	/**
+	 * Магазин (этот юнит) продаёт юнита: создаёт его рядом для игрока playerIndex и запускает события
+	 * EVENT_UNIT_SELL (на магазине) и EVENT_PLAYER_UNIT_SELL (у владельца магазина).
+	 */
+	public CUnit flomasterSellUnit(final CSimulation game, final int playerIndex, final War3ID soldTypeId,
+			final CUnit buyingUnit) {
