// Шаблон конфигурации игрового сервера.
// scripts/deploy.sh подставляет значения из .env и пишет результат в deploy/cs-server/server.cfg
// (файл не коммитится: в нём пароль RCON). Подставляются только известные переменные
// вида ${ИМЯ}; остальной текст копируется как есть.
// Файл монтируется в контейнер как /xashds/cstrike/server.cfg (только чтение).

// Имя сервера в списке серверов
hostname "${SERVER_NAME}"

// Пароль удалённого управления (RCON). Пусто = RCON выключен.
rcon_password "${RCON_PASSWORD}"

// Пароль на вход. Пусто = вход свободный.
sv_password ""

// Интернет-сервер, а не LAN
sv_lan 0

// Правила матча
// Длительность карты, минут
mp_timelimit 20
// Длительность раунда, минут
mp_roundtime 3
// Заморозка в начале раунда, секунд
mp_freezetime 3
// Таймер бомбы, секунд
mp_c4timer 35
// Время на закупку, минут (0.25 = 15 секунд)
mp_buytime 0.25
// Огонь по своим выключен
mp_friendlyfire 0
// Автобаланс команд
mp_autoteambalance 1
// Максимальная разница в численности команд
mp_limitteams 2
// Не кикать за убийства своих / бездействие
mp_autokick 0

// Скачивание и загрузка файлов выключены: сервер не раздаёт файлы игры,
// а у браузерных игроков нет докачки карт — в ротации только стандартные карты.
sv_allowdownload 0
sv_allowupload 0

// Движение
sv_maxspeed 320

// Читы выключены
sv_cheats 0

// Журнал сервера
log on

// Ротация карт
mapcyclefile mapcycle.txt

// Баны (файлы есть в образе upstream; если файла нет, сервер просто напишет предупреждение)
exec listip.cfg
exec banned.cfg
