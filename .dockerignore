# Контекст сборки образов (web собирается с контекстом = корень репозитория).
.git
**/node_modules
**/dist
data
.env
.env.*
!.env.example
*.zip

# Отрендеренные конфиги с секретами — в образы не попадают
deploy/cs-server/server.cfg
deploy/coturn/turnserver.conf
**/*.tmp
**/*.log

# Локальная копия cs16-client — скачивается внутри образа заново
web/vendor
# Сборка Warsmash — собирается внутри образа заново (стадия wc3 в web/Dockerfile)
web/public/games/wc3
build
